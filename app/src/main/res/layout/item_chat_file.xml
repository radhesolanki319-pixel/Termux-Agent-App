<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_agent_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="File"
        android:src="@drawable/ic_agent_file" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/agent_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_file_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/agent_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/card_file_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_bubble_user"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/agent_send_file"
        android:textColor="#FFFFFF" />
</LinearLayout>
