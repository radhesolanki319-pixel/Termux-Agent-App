<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agent_bg"
    android:orientation="vertical">

    <include layout="@layout/view_agent_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/simple_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/agent_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/simple_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_agent_circle"
            android:contentDescription="Add"
            android:padding="11dp"
            android:src="@drawable/ic_agent_plus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/simple_input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/simple_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_agent_pill"
            android:hint="Apni pasand ki feed banao..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingTop="11dp"
            android:paddingEnd="18dp"
            android:paddingBottom="11dp"
            android:textColor="@color/agent_text"
            android:textColorHint="@color/agent_dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/simple_input_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_agent_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Jodo"
            android:textColor="@color/agent_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/simple_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="Abhi kuch nahi hai"
        android:textColor="@color/agent_text_secondary"
        android:textSize="17sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/simple_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <include layout="@layout/view_agent_bottom_bar" />
</LinearLayout>
