<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_agent_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/card_result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/agent_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_result_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/agent_text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/card_result_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_agent_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/agent_text"
        android:visibility="gone" />
</LinearLayout>
