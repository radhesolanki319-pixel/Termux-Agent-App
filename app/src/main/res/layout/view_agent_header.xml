<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="216dp">

    <ImageButton
        android:id="@+id/header_menu_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_agent_circle"
        android:contentDescription="Menu"
        android:padding="11dp"
        android:src="@drawable/ic_agent_menu" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_agent_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/header_new_session_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New session"
            android:padding="9dp"
            android:src="@drawable/ic_new_session" />

        <ImageButton
            android:id="@+id/header_settings_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="9dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_agent_circle_dark">

            <TextureView
                android:id="@+id/header_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/header_avatar_still"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Agent"
                android:scaleType="centerCrop"
                android:src="@drawable/agent_avatar"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-14dp"
            android:background="@drawable/bg_agent_pill"
            android:gravity="center_horizontal"
            android:minWidth="150dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="5dp"
            android:paddingEnd="20dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/header_agent_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claude"
                android:textColor="@color/agent_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/header_agent_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/agent_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
